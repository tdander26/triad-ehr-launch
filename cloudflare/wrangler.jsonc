{
  "name": "triadehr-site",
  "compatibility_date": "2026-10-06",
  "main": "worker.js",
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": ["/assets/promo/*"] },
  "routes": [
    { "pattern": "triadehr.com", "custom_domain": true },
    { "pattern": "www.triadehr.com", "custom_domain": true }
  ]
}
